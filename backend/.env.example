# Example environment file for clubverse backend
# Copy this to .env and set real values before running the server.

# Postgres connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campus_activity
DB_USER=postgres
DB_PASSWORD=postgres_password_here

# Server port
PORT=5000

# JWT / other secrets (optional)
JWT_SECRET=your_jwt_secret_here

# Notes:
# - If your Postgres user/password differ, update DB_USER/DB_PASSWORD accordingly.
# - Alternatively set a full DATABASE_URL like: postgres://user:pass@host:5432/dbname
